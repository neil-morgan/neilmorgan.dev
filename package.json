{
  "name": "neilmorgan",
  "description": "Personal website of Neil Morgan",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/generate-styles-css.mjs --watch & next dev",
    "build": "npm run generate:styles && npm run codegen && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "jest",
    "test:watch": "jest --watch",
    "generate:styles": "node scripts/generate-styles-css.mjs",
    "generate:styles:watch": "node scripts/generate-styles-css.mjs --watch",
    "codegen": "graphql-codegen --require dotenv/config --config codegen.ts",
    "codegen:watch": "graphql-codegen --require dotenv/config --config codegen.ts -w"
  },
  "dependencies": {
    "@contentful/rich-text-react-renderer": "^16.1.6",
    "@contentful/rich-text-types": "^17.2.5",
    "@graphql-codegen/cli": "^6.1.0",
    "@graphql-codegen/near-operation-file-preset": "^4.0.0",
    "@graphql-codegen/typed-document-node": "^6.1.4",
    "@graphql-codegen/typescript": "^5.0.6",
    "@graphql-codegen/typescript-resolvers": "^5.1.4",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@next/env": "^16.0.7",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-separator": "^1.1.8",
    "crypto": "^1.0.1",
    "dotenv": "^17.2.3",
    "file-saver": "^2.0.5",
    "graphql": "^16.12.0",
    "html-react-parser": "^5.2.10",
    "motion": "^12.23.26",
    "next": "16.2.6",
    "postcss": "^8.5.6",
    "postcss-easing-gradients": "^3.0.1",
    "postcss-env-function": "^7.0.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-merge-refs": "^3.0.2",
    "react-responsive-masonry": "^2.7.1",
    "sanitize-html": "^2.17.0"
  },
  "devDependencies": {
    "@jest/globals": "^30.2.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-responsive-masonry": "^2.7.0",
    "@types/sanitize-html": "^2.16.0",
    "eslint": "^9",
    "eslint-config-next": "16.0.7",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "^5",
    "vitest": "^4.1.4"
  }
}
